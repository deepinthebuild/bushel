module(name = "bushel")

bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "llvm", version = "0.8.27")

register_toolchains("@llvm//toolchain:all")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.4")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")

# SDK commands do not inherit Bazel's C/C++ toolchain; keep them in pure mode.
go_deps.config(go_env = {"CGO_ENABLED": "0"})
go_deps.from_file(go_mod = "//:go.mod")

# Depend on the generated Go protobuf sources shipped in the Go modules.
go_deps.gazelle_default_attributes(directives = ["gazelle:proto disable_global"])
go_deps.gazelle_override(
    build_file_generation = "clean",
    directives = ["gazelle:proto disable_global"],
    path = "github.com/bazelbuild/remote-apis",
)
go_deps.gazelle_override(
    build_file_generation = "clean",
    directives = ["gazelle:proto disable_global"],
    path = "github.com/buildbarn/bb-storage",
)
go_deps.gazelle_override(
    build_file_generation = "clean",
    directives = ["gazelle:proto disable_global"],
    path = "github.com/envoyproxy/protoc-gen-validate",
)
go_deps.gazelle_override(
    build_file_generation = "clean",
    path = "github.com/google/go-jsonnet",
)
use_repo(
    go_deps,
    "com_github_bazelbuild_remote_apis",
    "com_github_buildbarn_bb_storage",
    "com_github_buildbarn_go_cdc",
    "com_github_gofrs_flock",
    "com_github_hashicorp_golang_lru",
    "com_github_ipfs_boxo",
    "com_github_ipfs_go_block_format",
    "com_github_ipfs_go_cid",
    "com_github_ipfs_go_datastore",
    "com_github_ipfs_go_ipld_format",
    "com_github_libp2p_go_libp2p",
    "com_github_libp2p_go_libp2p_kad_dht",
    "com_github_multiformats_go_base32",
    "com_github_multiformats_go_multiaddr",
    "com_github_multiformats_go_multihash",
    "net_pgregory_rapid",
    "org_golang_google_genproto_googleapis_bytestream",
    "org_golang_google_genproto_googleapis_rpc",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
)
