load("@bazel_lib//lib:copy_file.bzl", "copy_file")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_go//proto:def.bzl", "go_proto_library")

go_library(
    name = "pb",
    srcs = ["membership.pb.go"],
    importpath = "github.com/deepinthebuild/bushel/internal/membership/pb",
    visibility = ["//internal/membership:__subpackages__"],
    deps = [
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//runtime/protoimpl",
    ],
)

proto_library(
    name = "membership_proto",
    srcs = ["membership.proto"],
)

go_proto_library(
    name = "membership_go_proto",
    importpath = "github.com/deepinthebuild/bushel/internal/membership/pb",
    protos = [":membership_proto"],
    tags = ["manual"],
)

filegroup(
    name = "generated_go",
    srcs = [":membership_go_proto"],
    output_group = "go_generated_srcs",
)

write_source_files(
    name = "update",
    diff_test = False,
    files = {"membership.pb.go": ":generated_go"},
)

copy_file(
    name = "generated_source",
    src = ":generated_go",
    out = "generated/membership.pb.go",
)

go_test(
    name = "update_test",
    size = "small",
    srcs = ["generation_test.go"],
    embedsrcs = [
        ":generated_source",
        "membership.pb.go",
    ],
    gotags = ["bazel"],
)
