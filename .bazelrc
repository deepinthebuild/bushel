common --enable_bzlmod
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
common --repo_env=BAZEL_NO_APPLE_CPP_TOOLCHAIN=1
common --repo_env=BAZEL_MACOS_USE_HOST_SDK=0
common --@protobuf//bazel/toolchains:prefer_prebuilt_protoc=true
build --incompatible_strict_action_env
build --stamp=false
build --@rules_go//go/config:pure
run --run_in_cwd
test --test_output=errors
build:race --@rules_go//go/config:race
build:race --@rules_go//go/config:pure=false
